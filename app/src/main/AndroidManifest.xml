<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Para consumir el API REST del backend -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Para capturar la ubicación GPS al registrar un reporte (RF-05) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.RIETI"
        android:usesCleartextTraffic="false">

        <!-- Solo HTTPS. El build debug permite HTTP hacia 10.0.2.2 (ver src/debug).
             allowBackup=false: nada de la app se respalda en la nube (A17). -->

        <activity
            android:name=".view.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Fase 8: la cámara del sistema escribe la captura aquí (por intent, sin permiso de cámara).
             Solo expone la caché privada de capturas y únicamente a la app que recibe el permiso. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fotos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_fotos" />
        </provider>

    </application>

</manifest>
