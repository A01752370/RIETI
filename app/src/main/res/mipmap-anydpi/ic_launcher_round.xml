<?xml version="1.0" encoding="utf-8"?>
<!--
  Ícono adaptativo (aprobado: opción A): solo las dos caritas del logo de RIETI, sin texto,
  sobre fondo blanco y dentro de la zona segura de 66 dp. La capa frontal es un PNG por
  densidad (mipmap-*/ic_launcher_foreground.png) generado del logo original, solo escalado.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
