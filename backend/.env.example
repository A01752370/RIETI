# Copiar a .env para desarrollo local. Nunca subir .env al repositorio.
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rieti_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
# En AWS, DB_PASSWORD no se define: la API lee la contraseña de Secrets Manager (DB_SECRET_ARN).
DB_SECRET_ARN=
DB_SSL=false
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
AWS_REGION=mx-central-1
EVIDENCIAS_BUCKET=
CORS_ORIGINS=
