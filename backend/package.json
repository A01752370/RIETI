{
  "name": "rieti-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de RIETI (NestJS + PostgreSQL/PostGIS)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main",
